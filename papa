import {
  APP_JSON,
  DFP_SESSION_ID,
  FORM_URL_ENCODED,
  X_CORRELATION_ID,
  X_THMID
} from '../constants/common-enums';
import CONFIG from '../settings';
//import { helpers as GTMUtil } from 'vco-component-metrics';
import parseApiError from './parse-api-error';
import serializeObject from './serialize-object';
import StaticIdSingletonClass from './static-id';

export const defaultHeaders = {
  Accept: APP_JSON,
  'Content-Type': APP_JSON
};

